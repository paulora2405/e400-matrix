[Unit]
Description=darkFlash E400 Plus matrix display daemon
After=multi-user.target

[Service]
Type=simple
# Adjust User / paths for your install
WorkingDirectory=/opt/e400plus
ExecStart=/opt/e400plus/.venv/bin/python -m e400plus daemon --interval 500
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
