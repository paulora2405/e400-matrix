[Unit]
Description=darkFlash E400 Plus matrix display daemon
After=multi-user.target

[Service]
Type=simple
# install.sh renders User, WorkingDirectory, and the uv path for this machine.
User=paulo
WorkingDirectory=/home/paulo/.local/share/air-cooler-e400-matrix
# interval_ms and metrics_cache_ms are read from ~/.config/e400plus/config.yaml.
ExecStart=/usr/local/bin/uv run --script scripts/e400plus-daemon.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
